{
  "version": 1,
  "sessions": {
    "live-android-openclaw": {
      "name": "Live Android + OpenClaw",
      "goal": "Use a paired Android phone as Atlas visual context and OpenClaw as the upstream agent.",
      "mode": "assisted",
      "provider": {
        "id": "openclaw-live",
        "adapter": "@atlas/provider-openclaw/command",
        "config": {
          "command": "node",
          "args": ["examples/android-openclaw-basic/provider-wrapper.mjs"],
          "timeoutMs": 610000,
          "env": {
            "ATLAS_OPENCLAW_AGENT_SESSION_PREFIX": "atlas-live",
            "ATLAS_OPENCLAW_AGENT_TIMEOUT_SECONDS": "600",
            "ATLAS_OPENCLAW_HEARTBEAT_PROVIDER_MODE": "summary"
          }
        }
      },
      "devices": [
        {
          "id": "android-live",
          "adapter": "@atlas/device-android/bridge-command",
          "capabilities": ["camera.capture", "audio.speak"],
          "config": {
            "command": "node",
            "args": ["examples/android-openclaw-basic/bridge-wrapper.mjs"],
            "timeoutMs": 240000,
            "analysisMode": "openclaw",
            "maxWidth": 1024,
            "quality": 0.7,
            "speak": {
              "command": "node",
              "args": ["examples/android-openclaw-basic/bridge-wrapper.mjs"],
              "timeoutMs": 15000,
              "env": {
                "ATLAS_ANDROID_BRIDGE_NODE": "Galaxy S22 Ultra"
              },
              "stopCommand": "node",
              "stopArgs": ["examples/android-openclaw-basic/bridge-wrapper.mjs"],
              "stopTimeoutMs": 15000
            },
            "env": {
              "ATLAS_ANDROID_BRIDGE_NODE": "Galaxy S22 Ultra",
              "ATLAS_ANDROID_BRIDGE_IMAGES_DIR": ".atlas-cache/images",
              "ATLAS_ANDROID_BRIDGE_OPENCLAW_IMAGE_MODEL": "openai-codex/gpt-5.5",
              "ATLAS_ANDROID_BRIDGE_CAPTURE_TIMEOUT_MS": "60000",
              "ATLAS_ANDROID_BRIDGE_ANALYSIS_TIMEOUT_MS": "180000",
              "ATLAS_ANDROID_BRIDGE_CAPTURE_LOCK_TIMEOUT_MS": "120000",
              "ATLAS_ANDROID_BRIDGE_CAPTURE_LOCK_STALE_MS": "300000"
            }
          }
        }
      ],
      "analyzers": [],
      "heartbeat": {
        "enabled": false,
        "intervalMs": 30000,
        "policy": {
          "cadence": {
            "idle": 300000,
            "stable-scene": 60000,
            "active-task": 30000,
            "unstable-scene": 10000,
            "high-risk": 5000
          },
          "minDelayMs": 5000,
          "maxDelayMs": 300000,
          "expectedRefreshLatencyMs": 11000,
          "refreshSafetyMarginMs": 2500,
          "refreshFailureRetryMs": 120000,
          "providerReviewCooldownMs": 300000
        }
      }
    }
  }
}
