{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "description": "Atlas: Android-native, provider-independent physical agent runtime by Seth Esquieu",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:examples && npm run test:evals",
    "test:evals": "node evals/validate-fixtures.mjs",
    "check:public": "node scripts/check-public-readiness.mjs",
    "audit:history": "node scripts/audit-git-history.mjs",
    "test:examples": "node examples/android-openclaw-basic/wrapper-contracts.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo:live-android": "node examples/android-openclaw-basic/live-demo.mjs",
    "demo:ambient-android": "node examples/android-openclaw-basic/ambient-demo.mjs",
    "demo:smoke-android": "node examples/android-openclaw-basic/smoke-demo.mjs",
    "demo:smoke-ambient-android": "node examples/android-openclaw-basic/ambient-loop-smoke.mjs",
    "demo:ambient-loop": "node examples/ambient-loop.mjs",
    "demo:warm-context": "node examples/warm-context-harness.mjs",
    "demo:scenarios": "node examples/scenario-harness.mjs",
    "validate:ambient": "node examples/validate-ambient-run.mjs",
    "validate:scenarios": "node examples/validate-scenario-report.mjs",
    "replay:session": "node examples/replay-session.mjs",
    "loop:android": "node examples/android-openclaw-basic/loop-control.mjs",
    "demo:phone-loop": "node examples/android-openclaw-basic/loop-control.mjs demo",
    "demo:phone-voice-loop": "node examples/android-openclaw-basic/loop-control.mjs voice-demo",
    "openclaw:image-worker": "node examples/android-openclaw-basic/openclaw-image-worker.mjs",
    "bench:image-openclaw": "node examples/android-openclaw-basic/benchmark-image-analysis.mjs",
    "bench:image-openclaw:concurrent": "node examples/android-openclaw-basic/benchmark-image-concurrent.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SEsquieu/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/SEsquieu/atlas/issues"
  }
}
